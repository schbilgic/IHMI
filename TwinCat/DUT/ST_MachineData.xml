              <xhtml xmlns="http://www.w3.org/1999/xhtml">TYPE ST_MachineData :
STRUCT
    // Durum ve Kontrol
    bRunning         : BOOL := FALSE;
    bEmergencyStop   : BOOL := FALSE;
    bAlarmActive     : BOOL := FALSE;
	bStop			 : BOOL := FALSE;
	bStart			 : BOOL := FALSE;
    bReset     		: BOOL := FALSE;

	Alrm  :ARRAY[0..15] OF BOOL;

    nMachineState    : INT := 0;      // 0: Durdu, 1: Hazır, 2: Üretimde, 99: Hata

    // Analog / Ölçülen Değerler
    ftest     : REAL := 0.0;    // RPM
    fSpeedSet     : REAL := 0.0;    // RPM
	fSpeedActual     : REAL := 0.0;    // RPM
    fSpeedTarget     : REAL := 0.0;    // RPM
	fTemperature     : REAL := 25.0;   // °C
	fTemperatureTarget  : REAL := 25.0;   // °C
    fTemperatureAct     : REAL := 25.0;   // °C
	fTemperatureSet     : REAL := 25.0;   // °C
    fPressureAct        : REAL := 1.0;    // Bar
	fPressureSet        : REAL := 1.0;    // Bar
	
    // Üretim İstatistikleri
    
    fCycleTime       : REAL := 0.0;    // Çevrim süresi (saniye)
	nPartCounter     : DINT := 0;      // Toplam üretilen adet
END_STRUCT
END_TYPE</xhtml>
            </InterfaceAsPlainText>
